# QuickOps IQ frontend configuration. Copy to .env.local and fill in.
# Supabase dashboard -> Project Settings -> API (Data API / API Keys)
#
# ONLY these two public values belong in the browser bundle. Never put the
# database password, service_role key or sb_secret_ key in any VITE_ variable:
# Vite ships every VITE_* value to the browser. The app refuses to start if it
# detects a secret key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key (sb_publishable_...) or legacy anon key>
