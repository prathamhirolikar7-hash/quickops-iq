{
  "name": "quickops-iq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:db": "node supabase/tests/local/run-db-tests.mjs",
    "seed:local": "node scripts/seed/seed.mjs --target local",
    "seed:remote": "node --env-file=.env.seed.local scripts/seed/seed.mjs --target remote",
    "seed:preflight": "node --env-file=.env.seed.local scripts/seed/seed.mjs --target remote --preflight --ca-cert supabase/seed/supabase-ca.crt",
    "seed:verify": "node --env-file=.env.seed.local scripts/seed/seed.mjs --target remote --verify --ca-cert supabase/seed/supabase-ca.crt",
    "test:analytics": "node supabase/tests/local/run-analytics-tests.mjs",
    "test:unit": "node --test src/lib/*.test.ts",
    "test:realtime": "node supabase/tests/local/run-realtime-tests.mjs",
    "test:simulator": "node supabase/tests/local/run-simulator-tests.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "pg": "8.23.1",
    "shadcn": "4.21.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
